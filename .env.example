# ============================================
# POS HULIO - Konfigurasi build (opsional)
# ============================================
# Salin menjadi .env.local. Semua opsional — aplikasi jalan tanpa isi apa pun.

# --- AI (opsional, alternatif lokal) ---
# Disarankan: simpan kunci di server dengan `npx wrangler secret put OPENROUTER_API_KEY`.
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=openrouter/auto
# Model untuk membaca foto price list (OCR). Kosongkan untuk default.
VITE_OPENROUTER_VISION_MODEL=

# --- Toko bawaan (opsional) ---
# Isi agar semua perangkat otomatis memakai toko ini (tetap perlu login cloud sekali per perangkat).
VITE_STORE_ID=
VITE_STORE_NAME=
# Kosongkan bila API Cloudflare di domain yang sama dengan aplikasi (normal).
VITE_CLOUD_API_URL=

# --- Pengaturan Lanjutan ---
# Set false jika tidak ingin user mengubah konfigurasi dari UI
VITE_ALLOW_RUNTIME_SETTINGS=true
